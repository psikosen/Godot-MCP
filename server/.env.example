# Godot MCP Server Configuration

# Path to your Godot project directory (containing project.godot)
# If not set, the server will attempt to auto-detect the project
# GODOT_PROJECT_PATH=/Users/raymondgonzalez/mcp/Godot-MCP

# Path to the Godot executable
# Default for macOS: /Applications/Godot.app/Contents/MacOS/Godot
# Default for Linux: godot
# Default for Windows: C:\Program Files\Godot\Godot.exe
GODOT_EXECUTABLE=/Applications/Godot.app/Contents/MacOS/Godot

# Maximum time to wait for Godot to start (in milliseconds)
# Default: 30000 (30 seconds)
GODOT_STARTUP_TIMEOUT=30000

# WebSocket server configuration (for connecting to Godot)
# These should match your Godot plugin settings
GODOT_WS_HOST=localhost
GODOT_WS_PORT=9080

# Tool groups to expose (comma list, or "all"). Listing every tool costs about 67k tokens per
# session in clients that load all tool schemas; "core" alone is about 17k. Core is always on.
# Groups: core, 2d, 3d, animation, audio, navigation, physics, ui, procedural, assets, xr, multiplayer
# GODOT_MCP_TOOLSETS=2d,animation,ui
